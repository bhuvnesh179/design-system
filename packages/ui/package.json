{
  "name": "@100xbansal/ui",
  "version": "0.2.0",
  "description": "React 19 component library built with styled-components",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhuvnesh179/design-system.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/bhuvnesh179/design-system/tree/main/packages/ui#readme",
  "bugs": {
    "url": "https://github.com/bhuvnesh179/design-system/issues"
  },
  "keywords": [
    "react",
    "react-19",
    "design-system",
    "components",
    "styled-components",
    "ui"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@100xbansal/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@100xbansal/tokens": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@100xbansal/eslint-config": "workspace:*",
    "@100xbansal/typescript-config": "workspace:*",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.0",
    "styled-components": "^6.5.3",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
