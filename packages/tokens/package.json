{
  "name": "@100xbansal/tokens",
  "version": "0.1.0",
  "description": "Design tokens for the design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhuvnesh179/design-system.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/bhuvnesh179/design-system/tree/main/packages/tokens#readme",
  "bugs": {
    "url": "https://github.com/bhuvnesh179/design-system/issues"
  },
  "keywords": [
    "design-tokens",
    "design-system",
    "theme"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@100xbansal/source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc"
  },
  "devDependencies": {
    "@100xbansal/eslint-config": "workspace:*",
    "@100xbansal/typescript-config": "workspace:*",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      }
    }
  }
}
